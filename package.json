{
  "name": "agent-workbench",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "Local visual interface for coding-agent CLIs: Claude Code, Codex, OpenCode and Antigravity CLI",
  "keywords": [
    "claude-code",
    "codex",
    "opencode",
    "antigravity",
    "coding-agent",
    "ai-agents",
    "terminal",
    "pty",
    "xterm",
    "developer-tools",
    "cli",
    "ui"
  ],
  "license": "MIT",
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --filter @agent-workbench/server dev",
    "build": "pnpm --filter @agent-workbench/web build",
    "start": "pnpm --filter @agent-workbench/server start",
    "package": "node scripts/package.mjs",
    "build:npm": "node scripts/build-npm.mjs",
    "typecheck": "pnpm -r typecheck",
    "vault:import": "pnpm --filter @agent-workbench/server vault:import",
    "check": "pnpm --filter @agent-workbench/server check",
    "demo": "node scripts/demo/run.mjs",
    "demo:shots": "node scripts/demo/shots.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "playwright": "^1.63.0",
    "typescript": "^5.7.3"
  }
}
