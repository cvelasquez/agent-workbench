<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Emparejar -->
    <string name="pair_title">与电脑配对</string>
    <string name="pair_intro">这个应用通过家里网络中的 SSH 隧道，显示你电脑上运行的 Agent Workbench。不经过互联网。</string>
    <string name="pair_steps">1. 在电脑上的 Agent Workbench 中打开“远程访问”，选择“配对手机”。远程访问和电脑的 SSH 服务器都需要开启。\n2. 按提示把显示的那一行粘贴到电脑上。\n3. 扫描显示的代码。</string>
    <string name="pair_scan">扫描代码</string>
    <string name="pair_paste">改为粘贴代码的文本</string>
    <string name="pair_paste_hint">agentworkbench://pair?…</string>
    <string name="pair_use">使用</string>
    <string name="pair_invalid">这不是 Agent Workbench 的配对代码，或者来自其他版本的应用。</string>
    <string name="pair_confirm">以 %2$s 的身份与“%1$s”配对？</string>
    <string name="pair_confirm_ok">配对</string>
    <string name="pair_connecting">正在连接 %1$s…</string>
    <string name="pair_waiting_key">你的电脑还不接受这部手机的密钥。把对话框里的那一行粘贴到电脑上：手机会继续尝试。</string>
    <string name="pair_redeeming">正在配对…</string>
    <string name="pair_code_rejected">代码已过期或已被使用。在电脑上通过“配对手机”获取新的代码，再扫描一次：你粘贴的那一行仍然有效。</string>
    <string name="scan_prompt">把摄像头对准电脑屏幕上的代码</string>
    <string name="cancel">取消</string>

